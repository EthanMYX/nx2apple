From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: v0lumehi <aljic.zijad@googlemail.com>
Date: Wed, 28 Oct 2026 13:33:53 +0100
Subject: [PATCH] build_ipa.sh: slim package by default (DM_FULL_ROMFS=1 packs
 the game data)

Maps the RomFS and add-on content into the IPA only with DM_FULL_ROMFS; the app reads them from Documents/games/<id>/.

Upstream-Status: fork-only (upstream has the opt-in DM_COPY_ROMFS=NO since 32ae3b11; the fork's slim default differs)
Reason: Default slim IPA: the RomFS and aoc/ stay out unless DM_FULL_ROMFS=1 (a full package of a large game is many GB and iOS refuses it). Upstream took the opt-out DM_COPY_ROMFS=NO and kept the full package as its default
Issue: LNPANDY/NX2Apple#123
---
 dm/ios/tests/test_profile_pack.py |  3 ++-
 dm/ios/tools/build_ipa.sh         | 20 +++++++++++++++++---
 docs/env_switches.tsv             |  1 +
 3 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/dm/ios/tests/test_profile_pack.py b/dm/ios/tests/test_profile_pack.py
index 40db2b76..0407560d 100644
--- a/dm/ios/tests/test_profile_pack.py
+++ b/dm/ios/tests/test_profile_pack.py
@@ -53,7 +53,8 @@ class ProfilePackTests(unittest.TestCase):
                     self.assertEqual(prefix + 'fixture_bp.metallib' in names, included)
                     for name in ('fixture_b.metallib', 'fixture_bv.metallib', 'fixture_b.json'):
                         self.assertIn(prefix + name, names)
-                    self.assertEqual(archive.read('Payload/DmIOS.app/romfs/marker'), b'romfs')
+                    # the fork's slim package: the RomFS stays out of the IPA (DM_FULL_ROMFS=1 packs it)
+                    self.assertFalse(any(n.startswith('Payload/DmIOS.app/romfs') for n in names))
                     self.assertEqual('Payload/DmIOS.app/pso/prebuilt.tsv' in names, with_pso)
 
 
diff --git a/dm/ios/tools/build_ipa.sh b/dm/ios/tools/build_ipa.sh
index 3b4af1e7..25692fc8 100755
--- a/dm/ios/tools/build_ipa.sh
+++ b/dm/ios/tools/build_ipa.sh
@@ -152,11 +152,25 @@ APP=$DD/Build/Products/Release-iphoneos/DmIOS.app
 rm -rf "$APP/msl" "$O/Payload"   # Payload/: what the copy-and-zip packing left behind, as was out.ipa (and its index) unless it is the IPA packed here, which a repeat pack reuses
 [ "$O/out.ipa" -ef "$OUT_IPA" ] || rm -f "$O/out.ipa"; [ "$O/out.ipa.idx" -ef "$OUT_IPA.idx" ] || rm -f "$O/out.ipa.idx"
 P=Payload/DmIOS.app
-if [ -f "$ROMFS" ]; then MAPS=("$P/romfs.img=$ROMFS"); else MAPS=("$P/romfs=$ROMFS"); fi
-if [ -n "$AOC" ] && [ -d "$AOC" ]; then MAPS+=("$P/aoc=$AOC"); t "add-on content: $(ls "$AOC" | tr '\n' ' ')"; fi
+MAPS=()
+# DM_FULL_ROMFS=1 packs the game files into the package (upstream behaviour; only sensible for small
+# games — a full package of a large game is many GB and iOS refuses to install it with
+# PackageExtractionFailed). The default is the slim package: the app reads them from
+# Documents/games/<id>/ (romfs.img and aoc/<index>.img), which the launcher copies in one go and
+# which can also live on an external drive.
+if [ -n "${DM_FULL_ROMFS:-}" ]; then if [ -f "$ROMFS" ]; then MAPS=("$P/romfs.img=$ROMFS"); else MAPS=("$P/romfs=$ROMFS"); fi; fi
+if [ -n "${DM_FULL_ROMFS:-}" ] && [ -n "$AOC" ] && [ -d "$AOC" ]; then
+  MAPS+=("$P/aoc=$AOC"); t "add-on content packed into the IPA: $(ls "$AOC" | tr '\n' ' ')"
+elif [ -n "$AOC" ] && [ -d "$AOC" ]; then
+  t "add-on content alongside the game data (DM_FULL_ROMFS=1 packs it): $(ls "$AOC" | tr '\n' ' ')"
+fi
 if [ -n "${PSO:-}" ]; then MAPS+=("$P/pso=$PSO"); fi
 MAPS+=("$P/msl/$MSLDIR=$MSL_IOS/$MSLDIR" "$P=$APP")
-t "pack IPA (already-compressed game files stored, everything else deflated)"
+if [ -n "${DM_FULL_ROMFS:-}" ]; then
+  t "pack full IPA with RomFS (already-compressed game files stored, everything else deflated)"
+else
+  t "pack slim IPA without RomFS (game files come from Documents/romfs; DM_FULL_ROMFS=1 packs them)"
+fi
 # The pulling vertex libraries (<key>_bp, dm/gfx/tools/dmsh_pull.py) serve the hybrid pipelines. Default to the same pso_mtl4 setting compiled by gen_build.py; IOS_PULL=0 / 1 overrides it.
 # The pipeline archive's bases are made of them, so an IPA with an archive (pso/) always carries them, whatever IOS_PULL says (an Xcode build copies them always).
 PULL=$(sed -n 's/^#define DM_GAME_PSO_MTL4 //p' "$DM/host/gen/$GAME/game_profile.h") || die "read game profile header"
diff --git a/docs/env_switches.tsv b/docs/env_switches.tsv
index 242056b6..34c7bf88 100644
--- a/docs/env_switches.tsv
+++ b/docs/env_switches.tsv
@@ -33,6 +33,7 @@ DM_FS	diagnostic	When set, logs file opens, paths not found or not mounted, and
 DM_FSLOG	diagnostic	`=<file>` writes one TSV line per ReadFile: seconds since boot, guest path, offset, length and guest buffer address
 DM_FSLOG_HASH	diagnostic	With `DM_FSLOG`, adds a column with the FNV-1a 64 hash of the bytes read
 DM_FULLSCREEN	switch	When set, the Mac window starts in fullscreen
+DM_FULL_ROMFS	diagnostic	`=1` in `build_ipa.sh` packs the game data into the IPA as it did before the slim package; the default leaves it in `Documents/games/<id>/` (`romfs.img`, `aoc/<index>.img`) and the DLC beside it. Only for small games — a full package of a large one is many GB and iOS refuses it (`PackageExtractionFailed`)
 DM_GAME	switch	Selects the game profile (a title ID under `dm/games` or `DM_GAMES_DIR`) for the Python tools and the rewriter; there is no default
 DM_GAMES_DIR	path	Profile folders outside the repository, separated by `:`, searched after `dm/games`; the NSP script points it at a provisional or derived profile
 DM_GAMES_FIRST	switch	`=1` searches `DM_GAMES_DIR` before `dm/games`, so a provisional or derived profile wins over the game's own (the NSP script's `--provisional`)
