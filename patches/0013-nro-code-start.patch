Subject: [PATCH] patch_nso.py: an NRO's header is not code

code_start() and code_ranges() bound the site scan and the code ranges.

Upstream-Status: backport 3e77816c
Reason: An NRO's header is not code: the rewriter scanned it as instructions and stopped Final Fantasy X/X-2 HD Remaster (seedds/nxnative#397 closed: main has its own fix, 3e77816c; this patch drops once the bump takes it)
Issue: LNPANDY/NX2Apple#14
---
 dm/tools/patch_nso.py             | 17 +++++++--
 dm/tools/tests/test_nro_header.py | 59 +++++++++++++++++++++++++++++++
 2 files changed, 74 insertions(+), 2 deletions(-)
 create mode 100644 dm/tools/tests/test_nro_header.py

diff --git a/dm/tools/patch_nso.py b/dm/tools/patch_nso.py
index 7e02476d..1a235db2 100644
--- a/dm/tools/patch_nso.py
+++ b/dm/tools/patch_nso.py
@@ -20,8 +20,21 @@ from capstone.arm64 import ARM64_OP_IMM, ARM64_OP_MEM, ARM64_OP_REG
 import nso_asm
 from nso_asm import *   # the instruction encoders (B, ADRP, LDRX, ...), shared with the per-build patch files
 
+def code_start(d):
+    """Where the code in the text segment starts: 0x80 in an NRO, 0 in an NSO. An NRO's text segment begins at file and memory
+    offset 0 with the file's own header in it (the start word, the MOD0 offset, NRO0 at +0x10, the segment table at +0x20, the
+    build ID at +0x40), so scanning it from 0 read the header as instructions: the build ID decoded as "ldr x18, #…" and stopped
+    Final Fantasy X/X-2 HD Remaster's rewrite (GitHub issue LNPANDY/NX2Apple#14). An NSO's text holds code from 0."""
+    return 0x80 if d[0x10:0x14] == b'NRO0' else 0
+
+def code_ranges(data_blocks, text_end, start=0):
+    """The text's code ranges: the gaps between its data blocks (nso_code.data_blocks), none of them before `start` (code_start)"""
+    gaps = zip([0] + [e for _, e in data_blocks], [s for s, _ in data_blocks] + [text_end])
+    return [(max(s, start), e) for s, e in gaps if e > max(s, start)]
+
 src, outdir, NAME = sys.argv[1], sys.argv[2], sys.argv[3]
 d = open(src, 'rb').read()
+CODE_START = code_start(d)
 if d[0x10:0x14] == b'NRO0':
     # An NRO (a module the game loads at run time with nn::ro, Super Smash Bros. Ultimate's fighter code): the file is the image itself, each segment stored at its memory offset
     # and uncompressed; +0x20 text, +0x28 ro, +0x30 data as {offset, size}, +0x38 bss size, +0x40 the build ID. Rewritten as an NSO of the same layout would be
@@ -463,14 +476,14 @@ for _ in range(nfde):
     a, s = rd(o, tenc); o += s
     _, s = rd(o, tenc); o += s
     starts.add(a)
-starts = sorted(x for x in starts if x < TEXT_END)
+starts = sorted(x for x in starts if CODE_START <= x < TEXT_END)
 
 # ---- Linear scan to find all rewrite points (not relying on register read/write reports) ----
 # Data blocks in the text (nso_code.py: Absolum's main starts with 1.7 MB of them) are not code: words there that read as rewrite sites are left alone
 sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
 import nso_code
 DATA_BLOCKS = nso_code.data_blocks(IMG, TEXT_END, md)
-CODE_RANGES = list(zip([0] + [e for _, e in DATA_BLOCKS], [s for s, _ in DATA_BLOCKS] + [TEXT_END]))
+CODE_RANGES = code_ranges(DATA_BLOCKS, TEXT_END, CODE_START)
 md_lite = Cs(CS_ARCH_ARM64, CS_MODE_ARM)   # no details: the x18 scan reads only the operand text
 R18 = re.compile(r'\b[xw]18\b')
 def x18_words(lo, hi):
diff --git a/dm/tools/tests/test_nro_header.py b/dm/tools/tests/test_nro_header.py
new file mode 100644
index 00000000..6c7ab421
--- /dev/null
+++ b/dm/tools/tests/test_nro_header.py
@@ -0,0 +1,59 @@
+"""An NRO's header is not code (GitHub issue #14).
+
+An NRO's text segment starts at offset 0 with the file's own header in it: Hades' EOSSDK-Switch-Shipping.nro has text
+{0x0, 0xa41000} in its segment table and NRO0 at +0x10. Scanning it from 0 read the header's build ID as instructions and
+reported `44 ldr x18, #0xfffffffffff40370` on Final Fantasy X/X-2 HD Remaster. The segment table cannot give the bound
+(it says 0): the earlier TEXT_LO = segs[0][1] form kept scanning the header, and used TEXT_LO before defining it, which
+stopped every rewrite with a NameError.
+
+patch_nso.py's code_start() is 0x80 for an NRO and 0 for an NSO, and code_ranges() starts no code range before it; both
+scans (the x18 words and the rewrite sites) walk those ranges. This is seedds/nxnative#397, carried by patch_patch_nso in
+scripts/sync_upstream.py until it is upstream (its own test there is test_nro_code_start.py). The functions are taken
+from patch_nso.py itself, which runs as a script.
+"""
+import ast
+from pathlib import Path
+import struct
+import unittest
+
+TOOLS = Path(__file__).resolve().parents[1]
+SOURCE = (TOOLS / 'patch_nso.py').read_text(encoding='utf-8')
+scope = {}
+exec(compile(ast.Module(body=[n for n in ast.parse(SOURCE).body if isinstance(n, ast.FunctionDef) and n.name in ('code_start', 'code_ranges')],
+                        type_ignores=[]), str(TOOLS / 'patch_nso.py'), 'exec'), scope)
+code_start, code_ranges = scope['code_start'], scope['code_ranges']
+
+LDR_X18 = 0x58000000 | (0x7ff40370 >> 2 & 0x7ffff) << 5 | 18   # a literal load into x18: what the build ID's bytes read as
+
+
+def nro(text_size=0x1000):
+    """A synthetic NRO's first 0x80 bytes, laid out as Hades' EOS NRO is: text at offset 0 with the header inside it"""
+    h = bytearray(0x80)
+    h[0x10:0x14] = b'NRO0'
+    struct.pack_into('<II', h, 0x20, 0, text_size)   # text {offset, size}
+    struct.pack_into('<I', h, 0x44, LDR_X18)   # inside the build ID
+    return bytes(h)
+
+
+class CodeStart(unittest.TestCase):
+    def test_an_nro_s_header_is_outside_every_code_range(self):
+        d = nro()
+        self.assertEqual(struct.unpack_from('<II', d, 0x20)[0], 0, 'the segment table says 0, so it cannot bound the scan')
+        self.assertEqual(code_start(d), 0x80)
+        ranges = code_ranges([(0x400, 0x500)], 0x1000, code_start(d))
+        self.assertEqual(ranges, [(0x80, 0x400), (0x500, 0x1000)])
+        self.assertFalse(any(s <= 0x44 < e for s, e in ranges))
+
+    def test_an_nso_keeps_its_ranges(self):
+        self.assertEqual(code_start(b'NSO0' + bytes(0x7c)), 0)
+        self.assertEqual(code_ranges([(0x400, 0x500)], 0x1000), [(0, 0x400), (0x500, 0x1000)])
+
+    def test_the_bounds_are_defined_before_the_scan_uses_them(self):
+        """The NameError: each name the scan reads is assigned above its first use"""
+        for name, use in (('CODE_START', 'starts = sorted('), ('CODE_RANGES', 'x18 = set().union(')):
+            self.assertLess(SOURCE.index(f'{name} = '), SOURCE.index(use), name)
+        self.assertNotIn('TEXT_LO', SOURCE)
+
+
+if __name__ == '__main__':
+    unittest.main()
